{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Postgres": {
    "ConnectionString": "Host=postgres;Port=5432;Database=orderprocessing;Username=orderprocessing;Password=orderprocessing"
  },
  "IntegrationSimulator": {
    "MinDelaySeconds": 5,
    "MaxDelaySeconds": 10,
    "Mode": "Random",
    "FailureRate": 0.3
  },
  "Worker": {
    "PollingIntervalSeconds": 2,
    "ErrorBackoffSeconds": 5
  }
}
